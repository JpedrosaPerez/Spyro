<?xml version="1.0" encoding="utf-8"?>
<LinearLayout  xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="bottom|center"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <TextView
        android:id="@+id/saltar_guia"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/jump_guide"
        android:layout_margin="10dp"
        android:layout_gravity="start"
        android:textSize="20sp"
        />


    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"

        >
    <TextView
        android:id="@+id/text_step1"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:text="@string/guide_step_1"
        android:background="@drawable/fond_text"
        style="@style/TextoNormal"
        android:layout_gravity="center"

        android:alpha="0"
        />
        <TextView
            android:id="@+id/text_step4"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:text="@string/guide_step_4"
            android:background="@drawable/fond_text"
            style="@style/TextoNormal"
            android:alpha="0"
            android:layout_gravity="center"

            />

    <TextView
        android:id="@+id/text_step2"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:text="@string/guide_step_2"
        android:background="@drawable/fond_text"
        style="@style/TextoNormal"

        android:alpha="0"
        android:layout_gravity="center"

        />
    <TextView
        android:id="@+id/text_step3"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:text="@string/guide_step_3"
        android:background="@drawable/fond_text"
        style="@style/TextoNormal"

        android:alpha="0"
        android:layout_gravity="center"

        />
    </FrameLayout>
        <ImageView
            android:id="@+id/circulo_selector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0"
            app:srcCompat="@drawable/circulo_selector"
            android:layout_gravity="center"

            />

</LinearLayout>