<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:background="@color/purple_transparent">

    <TextView
        android:id="@+id/titulo_resumen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Resumen guía"
        android:textSize="28sp"
        android:padding="20dp"
        android:layout_margin="10dp" />

    <LinearLayout
        android:id="@+id/fila_personajes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:alpha="0"
        android:layout_margin="8dp">

        <TextView
            android:id="@+id/personajes_visto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Personajes"
            android:padding="12dp" />

        <ImageView
            android:id="@+id/check_personajes"
            android:layout_width="30dp"
            android:layout_height="30dp"
            app:srcCompat="@drawable/check" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fila_mundos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:alpha="0"
        android:layout_margin="8dp">

        <TextView
            android:id="@+id/mundo_visto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mundos"
            android:padding="12dp" />

        <ImageView
            android:id="@+id/check_mundos"
            android:layout_width="30dp"
            android:layout_height="30dp"
            app:srcCompat="@drawable/check" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fila_colecciones"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:alpha="0"
        android:layout_margin="8dp">

        <TextView
            android:id="@+id/collecciones_visto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Coleccionables"
            android:padding="12dp" />

        <ImageView
            android:id="@+id/check_colecciones"
            android:layout_width="30dp"
            android:layout_height="30dp"
            app:srcCompat="@drawable/check" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fila_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:alpha="0"
        android:layout_margin="8dp">

        <TextView
            android:id="@+id/info_visto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Información"
            android:padding="12dp" />

        <ImageView
            android:id="@+id/check_info"
            android:layout_width="30dp"
            android:layout_height="30dp"
            app:srcCompat="@drawable/check" />
    </LinearLayout>

    <Button
        android:id="@+id/button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Comenzar"
        android:layout_margin="30dp"
        android:alpha="0" />

</LinearLayout>