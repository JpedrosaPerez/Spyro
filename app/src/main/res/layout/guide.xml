<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:clickable="true"
    android:focusable="true"
    android:padding="30dp"
    android:background="@color/purple_transparent"
    android:gravity="center"
    >
<!--    android:visibility="gone"-->


    <TextView
        android:id="@+id/Bienvenido"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bienvenido"
        android:textAlignment="center"
        android:textSize="50dp"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:paddingBottom="20dp"
        />

    <TextView
        android:id="@+id/guiaText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Preparate para explorar el mundo magico de esta aplicación inspirada en "
        android:textColor="@color/white"
        android:paddingBottom="20dp"/>

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="150dp"
        android:layout_height="100dp"
        app:srcCompat="@drawable/spyro_logo"
        android:paddingBottom="20dp"
        />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Aqui aprenderas a navegar por pestañas llenas de dragones, mundos fascinantes y montones de tesoros brillantes"
        android:paddingBottom="20dp"/>

    <TextView
        android:id="@+id/textView4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="¿Listo para empezar?"
        android:paddingBottom="20dp"/>

    <TextView
        android:id="@+id/textView5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pulsa Comenzar y deja que Spyro te lleve volando a traves de esta guia interactiva."
        android:paddingBottom="20dp"/>
<FrameLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    >
    <ImageView
        android:id="@+id/imageView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:srcCompat="@drawable/gems"
        />

    <TextView
        android:id="@+id/button_comenzar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Comenzar"
        android:textAlignment="center"
        android:layout_gravity="center"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:clickable="true"
        android:focusable="true"
/>
</FrameLayout>

    <TextView
        android:id="@+id/saltar_guia_start"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Saltar Guia"
        android:clickable="true"
        android:textAlignment="textEnd"
        android:textSize="15sp"
        android:textColor="@color/white"/>


</LinearLayout>